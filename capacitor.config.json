{
  "appId": "top.izuna.foliamajor",
  "appName": "Folia",
  "webDir": "dist",
  "loggingBehavior": "debug",
  "backgroundColor": "#09090b",
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#09090b",
      "showSpinner": false,
      "androidSplashResourceName": "folia_icon",
      "androidScaleType": "FIT_CENTER"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#09090b"
    }
  },
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": false
  }
}
