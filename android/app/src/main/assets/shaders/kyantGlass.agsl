// Adapted from Kyant0/AndroidLiquidGlass commit 65ab177e90e5c1d8c62e70cf7755841982da65f6.
// Multi-surface single-WebView integration. Only the rim is optically displaced; interiors stay exact.
// Unlike Compose layerBackdrop, this consumes the existing native render output without drawing a View again.
uniform shader content;
uniform float4 glassRects[8];
uniform float2 glassParams[8];
uniform float surfaceCount;
uniform float pixelScale;
uniform float2 viewport;

float radiusAt(float2 coord, float4 radii) {
    if (coord.x >= 0.0) {
        if (coord.y <= 0.0) return radii.y;
        else return radii.z;
    } else {
        if (coord.y <= 0.0) return radii.x;
        else return radii.w;
    }
}

float sdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    float outside = length(max(cornerCoord, 0.0)) - radius;
    float inside = min(max(cornerCoord.x, cornerCoord.y), 0.0);
    return outside + inside;
}

float2 gradSdRoundedRect(float2 coord, float2 halfSize, float radius) {
    float2 cornerCoord = abs(coord) - (halfSize - float2(radius));
    if (cornerCoord.x >= 0.0 || cornerCoord.y >= 0.0) {
        return sign(coord) * normalize(max(cornerCoord, 0.0));
    } else {
        float gradX = step(cornerCoord.y, cornerCoord.x);
        return sign(coord) * float2(gradX, 1.0 - gradX);
    }
}
float circleMap(float x) { return 1.0 - sqrt(max(0.0, 1.0 - x * x)); }

half4 sampleContent(float2 coord) {
    return content.eval(clamp(coord, float2(0.0), viewport - float2(1.0)));
}

half4 dispersedSample(float2 refractedCoord, float2 dispersedCoord) {
    half4 color = half4(0.0);
    
    half4 red = sampleContent(refractedCoord + dispersedCoord);
    color.r += red.r / 3.5;
    color.a += red.a / 7.0;
    
    half4 orange = sampleContent(refractedCoord + dispersedCoord * (2.0 / 3.0));
    color.r += orange.r / 3.5;
    color.g += orange.g / 7.0;
    color.a += orange.a / 7.0;
    
    half4 yellow = sampleContent(refractedCoord + dispersedCoord * (1.0 / 3.0));
    color.r += yellow.r / 3.5;
    color.g += yellow.g / 3.5;
    color.a += yellow.a / 7.0;
    
    half4 green = sampleContent(refractedCoord);
    color.g += green.g / 3.5;
    color.a += green.a / 7.0;
    
    half4 cyan = sampleContent(refractedCoord - dispersedCoord * (1.0 / 3.0));
    color.g += cyan.g / 3.5;
    color.b += cyan.b / 3.0;
    color.a += cyan.a / 7.0;
    
    half4 blue = sampleContent(refractedCoord - dispersedCoord * (2.0 / 3.0));
    color.b += blue.b / 3.0;
    color.a += blue.a / 7.0;
    
    half4 purple = sampleContent(refractedCoord - dispersedCoord);
    color.r += purple.r / 7.0;
    color.b += purple.b / 3.0;
    color.a += purple.a / 7.0;
    
    return color;
}

half4 main(float2 coord) {
    half4 original = content.eval(coord);
    for (int i = 0; i < 8; i++) {
        if (float(i) >= surfaceCount) break;
        float4 rect = glassRects[i];
        if (coord.x < rect.x || coord.y < rect.y || coord.x > rect.x + rect.z || coord.y > rect.y + rect.w) continue;
        float2 halfSize = rect.zw * 0.5;
        float2 centeredCoord = coord - rect.xy - halfSize;
        float radius = min(glassParams[i].x, min(halfSize.x, halfSize.y));
        float sd = sdRoundedRect(centeredCoord, halfSize, radius);
        if (sd > 0.0) continue;
        float refractionHeight = min(7.0 * pixelScale, min(halfSize.x, halfSize.y) * 0.45);
        if (-sd >= refractionHeight) return original;
        float edge = clamp(1.0 + sd / refractionHeight, 0.0, 1.0);
        float d = circleMap(edge) * 16.0 * pixelScale;
        float gradRadius = min(radius * 1.5, min(halfSize.x, halfSize.y));
        float2 grad = normalize(gradSdRoundedRect(centeredCoord, halfSize, gradRadius) + 0.2 * normalize(centeredCoord));
        // Read outside the composited surface: keep foreground text out of the refracted backdrop.
        float2 refractedCoord = clamp(coord + (-sd + d) * grad, float2(0.0), viewport - float2(1.0));
        float dispersionIntensity = (centeredCoord.x * centeredCoord.y) / (halfSize.x * halfSize.y);
        float2 dispersedCoord = d * grad * dispersionIntensity;
        half4 color = dispersedSample(refractedCoord, dispersedCoord);
        float light = pow(abs(dot(grad, float2(-0.70710678))), 1.5);
        half glint = half(pow(edge, 5.0) * light * 0.22);
        color.rgb = min(color.rgb + glint * color.a, half3(color.a));
        return mix(original, color, half(edge * glassParams[i].y));
    }
    return original;
}
